rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','amount','date','category','payment','recurringId','createdAt','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.amount is number && d.amount > 0 && d.amount < 1000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.category is string && d.category.size() <= 30
        && d.payment is string && d.payment.size() <= 30
        && (!('recurringId' in d) || (d.recurringId is string && d.recurringId.size() <= 40));
    }

    function validRecurring() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','amount','category','payment','frequency','anchorDay','startDate','nextDate','active','createdAt','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.amount is number && d.amount > 0 && d.amount < 1000000
        && d.category is string && d.category.size() <= 30
        && d.payment is string && d.payment.size() <= 30
        && d.frequency in ['weekly','monthly','yearly']
        && d.anchorDay is int && d.anchorDay >= 1 && d.anchorDay <= 31
        && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.nextDate is string && d.nextDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.active is bool;
    }

    function validBudgets() {
      let d = request.resource.data;
      return d.keys().hasOnly(['limits','updatedAt'])
        && d.limits is map && d.limits.size() <= 20;
    }

    match /users/{userId}/expenses/{expenseId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validExpense();
    }

    match /users/{userId}/recurring/{ruleId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validRecurring();
    }

    match /users/{userId}/settings/{docId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && docId == 'budgets' && validBudgets();
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
